#!/bin/sh
set -eu
if [ "${1:-}" = toggle ]; then
    if systemctl --user is-active --quiet hypridle.service; then
        systemctl --user stop hypridle.service
    else
        systemctl --user start hypridle.service
    fi
    systemctl --user kill --kill-whom=main -s RTMIN+9 lixx-waybar.service 2>/dev/null || :
elif systemctl --user is-active --quiet hypridle.service; then
    echo '{"text": ""}'
else
    echo '{"text": "󱫖", "tooltip": "Idle lock disabled", "class": "active"}'
fi
