[Unit]
Description=Waybar for the Lixx desktop
PartOf=graphical-session.target
# Stop the DND subscriber before SwayNC during logout.
After=wayland-wm@hyprland.desktop.service wayland-session-waitenv.service swaync.service

[Service]
Type=exec
ExecStart=%D/lixx-system/bin/lixx-waybar
Restart=on-failure
RestartSec=2
Slice=app.slice
